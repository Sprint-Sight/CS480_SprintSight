# Outbound email (replace placeholders with your provider's SMTP credentials).
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-provider-username
EMAIL_SMTP_PASSWORD=your-provider-smtp-or-api-key
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.example
EMAIL_FROM_NAME=SprintSight
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# Public URL where the frontend is available to email recipients.
EMAIL_FRONTEND_BASE_URL=http://localhost:3000

# First-time links last one day; password-reset links last 30 minutes.
EMAIL_FIRST_TIME_TOKEN_EXPIRE_MINUTES=1440
EMAIL_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
