# Copy to backend/.env and fill in. Never commit the real file.
# Required (the app refuses to start without them): SECRET_KEY, POSTGRES_PASSWORD,
# MINIO_ACCESS_KEY, MINIO_SECRET_KEY.

# ── Core ────────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENVIRONMENT=development
# Browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Fernet key for stored Jira API tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ── Postgres ────────────────────────────────────────────────────────────────────
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sprintsight

# ── MinIO (S3-compatible object store) ──────────────────────────────────────────
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET_RAW=raw-jira-data

# ── Bootstrap accounts (created on first start only if missing) ─────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@example.com
BOOTSTRAP_INSTRUCTOR_PASSWORD=change-me
BOOTSTRAP_INSTRUCTOR_NAME=Sample Instructor
BOOTSTRAP_STUDENT_EMAIL=
BOOTSTRAP_STUDENT_PASSWORD=
BOOTSTRAP_STUDENT_NAME=Sample Student

# ── Git / Jira ──────────────────────────────────────────────────────────────────
# Cloned team repositories live under this folder (docker-compose mounts ../repo here).
LOCAL_REPOSITORY_ROOT=/app/repo
JIRA_TIMEOUT_SECONDS=30

# ── AI engine ───────────────────────────────────────────────────────────────────
# Label stored on each report (the backend always calls AI_ENGINE_URL).
ASSESSMENT_MODE=ai
DEFAULT_MODEL_NAME=sprintsight-qwen
# Inside Docker the engine is on the host: host.docker.internal (extra_hosts is set in compose).
AI_ENGINE_URL=http://host.docker.internal:8001
# Must equal AI_ENGINE_SERVICE_TOKEN in ai-engine/.env. Empty = no token sent (local demo only).
AI_ENGINE_SERVICE_TOKEN=
# Read timeout for one whole assessment, in seconds.
AI_ENGINE_TIMEOUT_SECONDS=3600
# Assessments sent to the engine at once. The engine grades one at a time, so leave this at 1:
# extra jobs then stay queued here instead of waiting on the engine until the timeout.
AI_ENGINE_MAX_CONCURRENCY=1
# Only for the progress bar: a first guess, in seconds, at how long one engine step (one model
# call) takes. It is learned from the first finished step. Raise it for a slow model or GPU.
AI_PROGRESS_EXPECTED_STEP_SECONDS=120
# A backend refreshes its running jobs' heartbeat this often (seconds). At startup, and on every
# heartbeat, a job whose heartbeat is older than the stale limit is failed as retryable: its
# backend stopped. Keep the stale limit several heartbeats long.
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_AFTER_SECONDS=120

# Tests only: a throwaway Postgres for tests/test_postgres_*.py (they skip when unset). The
# database is WIPED, so its name must contain "test". CI sets this automatically.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprintsight_test

# ── AI Insights (MLflow) ────────────────────────────────────────────────────────
# docker-compose.yml sets these for the backend container; set them here for a host run.
# The backend only reads traces by id and writes instructor labels; keep the MLflow client
# version equal to the server (see pyproject.toml).
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MLFLOW_HTTP_REQUEST_TIMEOUT=5
INSIGHTS_ENABLED=true
INSIGHTS_LABEL_SYNC_INTERVAL_SECONDS=30
# Minutes before a report with no judge result is called stale (stale ones are re-checked for 24 h).
INSIGHTS_JUDGE_STALE_MINUTES=120
# blind_label: label first, then reveal. override_gate: Insights unlock after an instructor override.
INSIGHTS_MODE=blind_label

# ── Email ───────────────────────────────────────────────────────────────────────
# smtp sends real mail; file writes messages to EMAIL_OUTBOX_PATH; none disables email.
EMAIL_TRANSPORT=file
EMAIL_OUTBOX_PATH=logs/email-outbox
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SprintSight
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_FRONTEND_BASE_URL=http://localhost:3000
EMAIL_FIRST_TIME_TOKEN_EXPIRE_MINUTES=1440
EMAIL_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_DAILY_SEND_CAP=450
EMAIL_SEND_INTERVAL_SECONDS=1
EMAIL_DISPATCH_INTERVAL_SECONDS=5
EMAIL_SMTP_MAX_ATTEMPTS=3
EMAIL_SMTP_RETRY_BACKOFF_SECONDS=2
EMAIL_SMTP_CIRCUIT_BREAKER_SECONDS=300
EMAIL_QUOTA_BACKOFF_SECONDS=1800
EMAIL_QUEUE_MAX_ATTEMPTS=5
