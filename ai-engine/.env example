## RENAME to .env

# ── Local mode (Ollama runs in Docker Compose) ──
OLLAMA_BASE_URL="http://ollama:11434/v1"
OLLAMA_API_KEY=<CREATE_YOUR_OWN_OLLAMA_API_KEY>

# ── HPC mode (Ollama on the GPU cluster via SSH tunnel) ──
# Uncomment these and comment out the local-mode line above.
# The port must match LOCAL_OLLAMA_PORT in .env.hpc (default 11435).
# OLLAMA_BASE_URL="http://host.docker.internal:11435/v1"

# MLflow
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="sprintsight"

# Debug: print full ingested bundle on /assess/sprint/data
LOG_BUNDLE_DISPLAY=false

# LLM config
LLM_COMMIT_BUDGET=30
LLM_MAX_FILES_PER_COMMIT=20

# Evidence packing (services/evidence_packer.py). "packed" fits every commit,
# line-numbered files at HEAD, and diff excerpts into the token budget;
# "legacy" restores the old 30-commit JSON sample (LLM_COMMIT_BUDGET).
LLM_EVIDENCE_MODE=packed
# Prompt + answer tokens per dimension call, even if num_ctx allows more.
LLM_EVIDENCE_CONTEXT_CAP=32000
LLM_OUTPUT_RESERVE_TOKENS=2048
# Token estimate ratio; lower it if audit logs show prompts near num_ctx.
LLM_CHARS_PER_TOKEN=3.0
# Optional: one line cap for every file category (default 120 source,
# 150 tests, 250 docs, 200 CI/CD).
# LLM_EVIDENCE_MAX_FILE_LINES=150
LLM_EVIDENCE_MAX_DIFF_LINES=60

# GPU throughput (see "Measuring GPU utilisation" in hpc/README.md).
# Rubric dimensions sent to Ollama at once; keep equal to the GPU job's
# OLLAMA_NUM_PARALLEL. 1 = one after another (the default).
LLM_DIMENSION_CONCURRENCY=1
# Ollama prefill batch size (num_batch); unset = Ollama's default of 512.
# LLM_NUM_BATCH=1024
# Where per-request timing markers go (default <LLM_AUDIT_LOG_DIR>/request_markers.jsonl).
# LLM_REQUEST_MARKERS_PATH=
