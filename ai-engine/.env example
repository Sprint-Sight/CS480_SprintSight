# ── Local mode (Ollama runs in Docker Compose) ──
OLLAMA_BASE_URL="http://ollama:11434/v1"
OLLAMA_API_KEY=<CREATE_YOUR_OWN_OLLAMA_API_KEY>

# ── HPC mode (Ollama on the GPU cluster via SSH tunnel) ──
# Uncomment these and comment out the local-mode line above.
# The port must match LOCAL_OLLAMA_PORT in .env.hpc (default 11435).
# OLLAMA_BASE_URL="http://host.docker.internal:11435/v1"

# MLflow
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="sprintsight"

# Debug: print full ingested bundle on /assess/sprint/data
LOG_BUNDLE_DISPLAY=false
