# ── HPC Dev Configuration ──
# Copy to .env.hpc and adjust for your setup.
# These values are read by hpc/hpc-dev.sh.

# SSH login to the HPC cluster head node
HPC_USER=CS480G2
HPC_LOGIN_HOST=10.193.104.102

# Local port for the SSH tunnel to Ollama on the compute node.
# Use a port other than 11434 if you also run Ollama locally.
LOCAL_OLLAMA_PORT=11435

# Remote Ollama port on the compute node (almost always 11434)
REMOTE_OLLAMA_PORT=11434

# Slurm job name to look for (matches --job-name in ollama_gpu.sbatch)
SLURM_JOB_NAME=sprintsight-ollama

# ── GPU job settings (optional; forwarded by `hpc-dev.sh submit`) ──
# Pin a GPU model so benchmarks from different jobs are comparable.
# List the cluster's GPU types with: sinfo -o "%N %G"
# HPC_GPU_TYPE=
# Requests one loaded model decodes at once. Match LLM_DIMENSION_CONCURRENCY
# in ai-engine/.env. KV cache grows with num_ctx x this, so keep 1 for 32B models.
# OLLAMA_NUM_PARALLEL=1
# f16 | q8_0 | q4_0 (job default q4_0, needed for the 32B models)
# OLLAMA_KV_CACHE_TYPE=q4_0
# OLLAMA_KEEP_ALIVE=30m
# Models resident at once (job default 1; more let idle models block requests)
# OLLAMA_MAX_LOADED_MODELS=1
# nvidia-smi sample interval for the job's GPU telemetry CSV
# GPU_SAMPLE_MS=1000
